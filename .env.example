NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials (do NOT prefix with NEXT_PUBLIC_)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Outgoing email (SMTP) — used for OTP, welcome, donation-confirmed,
# password reset, blood-request, blood-type-changed, new-sign-in, account
# deleted, and the rare security/feature broadcast emails. All go through
# src/backend/lib/mailer.ts. Any SMTP provider works; defaults assume Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Secret required to call /api/admin/broadcast (security policy / new
# feature emails to all users). Not tied to any UI — call it yourself.
ADMIN_BROADCAST_SECRET=

# Public site URL used to build links inside outgoing emails, and to load
# the logo/hero images in those emails from /email/logo.png and
# /email/hero/*.png in the public folder. Should NOT have a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
