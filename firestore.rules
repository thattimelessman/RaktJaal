rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /* ---------------------------------------------------------------
       users/{uid}: the private account/profile doc. Owner only.
       (Server routes use the Admin SDK and bypass these rules.)
    ---------------------------------------------------------------- */
    match /users/{uid} {
      allow read, create: if isSelf(uid);

      // Safety-critical fields are guarded server-side, not just in the UI:
      //  - bloodType can only change while bloodTypeUnlocked == true (set by an
      //    admin via /api/admin/unlock-blood-type after a support request)
      //  - a client can never set bloodTypeUnlocked to true itself
      //  - twoFactorEnabled can be turned ON by the owner, but only the server
      //    (/api/account/disable-2fa, after an email OTP) can turn it OFF
      allow update: if isSelf(uid)
        && (
          resource.data.get('bloodType', '') == ''
          || request.resource.data.get('bloodType', '') == resource.data.get('bloodType', '')
          || resource.data.get('bloodTypeUnlocked', false) == true
        )
        && (
          request.resource.data.get('bloodTypeUnlocked', false) == false
          || request.resource.data.get('bloodTypeUnlocked', false) == resource.data.get('bloodTypeUnlocked', false)
        )
        && (
          resource.data.get('twoFactorEnabled', false) == false
          || request.resource.data.get('twoFactorEnabled', false) == true
        );

      // Accounts are deleted through /api/account/delete (Admin SDK).
      allow delete: if false;
    }

    /* ---------------------------------------------------------------
       donors/{uid}: the public donor card used for nearby search.
       Readable by signed-in users only (so the directory can't be
       scraped anonymously). Written only by the donor themselves.
       Docs created by the main app hold NO phone number; that lives
       in donors_private.
    ---------------------------------------------------------------- */
    match /donors/{donorId} {
      allow read: if signedIn();
      allow create, update, delete: if isSelf(donorId);
    }

    /* ---------------------------------------------------------------
       donors_private/{uid}: the owner's own copy of their phone number.
       Owner-only. It is never read by anyone else: the counter-party gets
       the number through requests/{id}/contacts (below), and only once a
       request between the two has been approved.
    ---------------------------------------------------------------- */
    match /donors_private/{donorId} {
      allow read, create, update, delete: if isSelf(donorId);
    }

    /* ---------------------------------------------------------------
       requests/{requesterUid}_{donorUid}: one person asking one donor.
       - only the requester can create it, only as themselves, and only
         in the "pending" state
       - only the two people on it can read it
       - the DONOR may move it pending -> approved/declined
       - the REQUESTER may move it pending -> cancelled
       - identity/blood/location fields can never change after create
    ---------------------------------------------------------------- */
    match /requests/{requestId} {

  // Participants can always read their own requests.
  // Any signed-in user can read PENDING requests so the
  // Donate Blood city feed can work.
  allow read: if signedIn()
    && (
      resource.data.requesterUid == request.auth.uid
      || resource.data.donorUid == request.auth.uid
      || resource.data.status == 'pending'
    );

  // Requester creates their own pending request. Two shapes:
  //  - DIRECT: addressed to one donor, id = requesterUid_donorUid
  //  - OPEN:   donorUid == null, id = requesterUid_open_<timestamp>; any
  //            registered donor can accept it later.
  allow create: if signedIn()
    && request.resource.data.requesterUid == request.auth.uid
    && request.resource.data.status == 'pending'
    && request.resource.data.units is int
    && request.resource.data.units >= 1
    && request.resource.data.units <= 20
    && (
      (
        request.resource.data.donorUid is string
        && request.resource.data.donorUid != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.donorUid
      )
      ||
      (
        request.resource.data.donorUid == null
        && requestId.matches(request.auth.uid + '_open_[0-9]+')
      )
    );

  // Status transitions.
  allow update: if signedIn()
    && request.resource.data.diff(resource.data).affectedKeys()
         .hasOnly(['status', 'threadId', 'approvedAt', 'updatedAt'])
    && (
      // Donor: pending -> approved/declined
      (
        resource.data.status == 'pending'
        && resource.data.donorUid == request.auth.uid
        && request.resource.data.status in ['approved', 'declined']
      )

      ||

      // Requester: pending -> cancelled
      (
        resource.data.status == 'pending'
        && resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'cancelled'
      )

      ||

      // Requester: cancelled -> pending
      (
        resource.data.status == 'cancelled'
        && resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'pending'
      )
    );

  // A donor accepts an OPEN request: claims it (donorUid null -> me) and
  // approves it in one write. Only while pending and unclaimed, so two donors
  // racing can't both win. Any registered donor may accept, whatever their blood
  // group: a family member or a blood bank can help with any request.
  allow update: if signedIn()
    && request.resource.data.diff(resource.data).affectedKeys()
         .hasOnly(['status', 'threadId', 'approvedAt', 'updatedAt', 'donorUid', 'donorName', 'donorPhoto'])
    && resource.data.donorUid == null
    && resource.data.status == 'pending'
    && resource.data.requesterUid != request.auth.uid
    && request.resource.data.donorUid == request.auth.uid
    && request.resource.data.status == 'approved'
    && exists(/databases/$(database)/documents/donors/$(request.auth.uid));

  allow delete: if false;

  /* ---------------- contacts ---------------- */

  match /contacts/{contactUid} {

    // Each person may publish only their own contact information,
    // and only if they are a participant in this request.
    allow create, update: if isSelf(contactUid)
      && request.auth.uid in [
        get(/databases/$(database)/documents/requests/$(requestId)).data.requesterUid,
        get(/databases/$(database)/documents/requests/$(requestId)).data.donorUid
      ]
      && request.resource.data.keys().hasOnly([
        'uid', 'phone', 'updatedAt'
      ])
      && request.resource.data.uid == request.auth.uid;

    // Contacts become readable only after approval.
    allow read: if signedIn()
      && get(/databases/$(database)/documents/requests/$(requestId)).data.status == 'approved'
      && request.auth.uid in [
        get(/databases/$(database)/documents/requests/$(requestId)).data.requesterUid,
        get(/databases/$(database)/documents/requests/$(requestId)).data.donorUid
      ];

    allow delete: if false;
  }
}

    /* ---------------------------------------------------------------
       threads/{id}: chat between the two people on an approved request.
       Only the donor can open it (as part of approving), and only for a
       request that exists. Only participants can read or write.
    ---------------------------------------------------------------- */
    match /threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      // NOTE: the thread is created in the SAME batch that flips the request to
      // 'approved'. Inside a batch, get()/exists() see the state from BEFORE the
      // batch, so the request is still 'pending' here. Do NOT add a status check to
      // this rule, or approving will start failing with permission-denied.
      // For an OPEN request the donor is not on the request yet at this point
      // (donorUid is still null pre-batch), so accept: the caller is a
      // participant, the other participant is the requester, and the request
      // is still unclaimed.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && exists(/databases/$(database)/documents/requests/$(threadId))
        && (
          get(/databases/$(database)/documents/requests/$(threadId)).data.donorUid == request.auth.uid
          ||
          (
            get(/databases/$(database)/documents/requests/$(threadId)).data.donorUid == null
            && get(/databases/$(database)/documents/requests/$(threadId)).data.status == 'pending'
            && request.resource.data.participants.hasAll([
                 get(/databases/$(database)/documents/requests/$(threadId)).data.requesterUid,
                 request.auth.uid
               ])
          )
        );

      // Participants may update last-message + unread counters only.
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageAt', 'unread', 'photos']);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;

        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants
          && request.resource.data.from == request.auth.uid
          && request.resource.data.type in ['text', 'image', 'file'];

        allow update, delete: if false;
      }
    }

    /* ---------------------------------------------------------------
       notifications/{id}: per-user inbox items.
       - the recipient reads them and marks them read
       - any signed-in user may create one addressed to someone else
         (that is how "you got a request" reaches the donor); content is
         constrained, and it cannot be created as already-read.
    ---------------------------------------------------------------- */
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'title', 'body', 'tone', 'read', 'createdAt', 'kind', 'requestId', 'threadId'])
        && (!('kind' in request.resource.data) || request.resource.data.kind in [
             'incoming-request', 'open-request', 'thread', 'sent-update', 'confirm-donation', 'history', 'profile'
           ])
        && request.resource.data.read == false
        && request.resource.data.tone in ['info', 'success']
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 300;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    // emailOtps and anything else: no client access (Admin SDK only).
  }
}
